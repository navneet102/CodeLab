{
  "name": "codesync",
  "version": "1.0.0",
  "description": "Real-time collaborative coding platform",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "workers"
  ],
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:worker": "cd workers && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
